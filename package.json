{
  "name": "taskflow",
  "version": "1.0.0",
  "description": "Gestor de tareas local",
  "author": "Pa7r1",
  "main": "main/main.js",
  "scripts": {
    "start": "concurrently \"pnpm run dev:renderer\" \"wait-on http://127.0.0.1:42879 && env -u ELECTRON_RUN_AS_NODE electron .\"",
    "dev:renderer": "pnpm --filter taskflow-renderer dev",
    "build:renderer": "pnpm --filter taskflow-renderer build",
    "build": "pnpm run build:renderer && electron-builder",
    "test": "pnpm --filter taskflow-renderer test",
    "format": "prettier --write .",
    "postinstall": "electron-builder install-app-deps",
    "rebuild:native": "electron-builder install-app-deps"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^43.3.0",
    "electron-builder": "^26.8.1",
    "prettier": "^3.9.6",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.taskflow.app",
    "productName": "TaskFlow",
    "files": [
      "main/**/*",
      "renderer/dist/**/*",
      "preload.js",
      "assets/**/*"
    ],
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png",
      "category": "Utility"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.png"
    }
  },
  "packageManager": "pnpm@10.17.1"
}
